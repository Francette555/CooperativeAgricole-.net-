@model tedd.Models.RapportFinancier
@{
    ViewData["Title"] = $"Rapport - {Model.Periode}";
    var moisActuel = DateTime.ParseExact(Model.Mois, "MMMM", System.Globalization.CultureInfo.CurrentCulture).Month;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-file-alt text-primary me-2"></i>Rapport financier
            <small class="text-muted fs-6">@Model.Periode</small>
        </h1>
        <div>
            <a asp-action="ExportPDF" asp-route-id="@Model.Id" class="btn btn-danger" target="_blank">
                <i class="fas fa-file-pdf me-2"></i>Télécharger PDF
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
        </div>
    </div>

    <!-- Indicateurs clés -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Période
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Periode</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Total Ventes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-success">@Model.TotalVentes.ToString("N0") Ar</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-shopping-cart fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Total Paiements
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-danger">@Model.TotalPaiements.ToString("N0") Ar</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Bénéfice
                            </div>
                            <div class="h5 mb-0 font-weight-bold @(Model.Benefice >= 0 ? "text-success" : "text-danger")">
                                @Model.Benefice.ToString("N0") Ar
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Détails -->
    <div class="row">
        <!-- Colonne Gauche : Ventes par produit -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-bar me-2"></i>Ventes par produit (@Model.Mois @Model.Annee)
                    </h6>
                </div>
                <div class="card-body">
                    @{
                        var ventes = ViewBag.VentesParProduit as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
                    }
                    @if (ventes.Any())
                    {
                        var totalVentes = ventes.Values.Sum();
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produit</th>
                                        <th class="text-end">Quantité (kg)</th>
                                        <th class="text-end">Montant</th>
                                        <th class="text-end">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ventes)
                                    {
                                        var pourcentage = totalVentes > 0 ? (item.Value / totalVentes * 100) : 0;
                                        <tr>
                                            <td>
                                                <i class="fas fa-box text-primary me-2"></i>
                                                @item.Key
                                            </td>
                                            <td class="text-end">-</td>
                                            <td class="text-end fw-bold text-success">@item.Value.ToString("N0") Ar</td>
                                            <td class="text-end">@pourcentage.ToString("F1")%</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-primary fw-bold">
                                    <tr>
                                        <td>TOTAL</td>
                                        <td class="text-end">-</td>
                                        <td class="text-end">@totalVentes.ToString("N0") Ar</td>
                                        <td class="text-end">100%</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Aucune vente enregistrée pour @Model.Mois @Model.Annee</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Colonne Droite : Paiements en attente -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-clock me-2"></i>Paiements en attente
                    </h6>
                </div>
                <div class="card-body">
                    @{
                        var paiements = ViewBag.PaiementsNonPayes as List<tedd.Models.Paiement> ?? new List<tedd.Models.Paiement>();
                    }
                    @if (paiements.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producteur</th>
                                        <th class="text-end">Montant</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in paiements.Take(10))
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-user text-warning me-2"></i>
                                                @item.Producteur?.NomComplet
                                            </td>
                                            <td class="text-end fw-bold text-warning">@item.Montant.ToString("N0") Ar</td>
                                            <td>@item.DatePaiement.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (paiements.Count > 10)
                                {
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">
                                                <small>+ @(paiements.Count - 10) autres paiements en attente</small>
                                            </td>
                                        </tr>
                                    </tfoot>
                                }
                                <tfoot class="table-warning fw-bold">
                                    <tr>
                                        <td>TOTAL EN ATTENTE</td>
                                        <td class="text-end">@paiements.Sum(p => p.Montant).ToString("N0") Ar</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <p class="text-muted">Aucun paiement en attente</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Informations du rapport -->
    <div class="card shadow">
        <div class="card-footer bg-light text-muted">
            <div class="row">
                <div class="col-md-6">
                    <small>
                        <i class="fas fa-calendar-alt me-1"></i>
                        Généré le : @Model.DateGeneration.ToString("dd/MM/yyyy à HH:mm")
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <small>
                        <i class="fas fa-code me-1"></i>
                        ID : #@Model.Id
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 4px solid #4e73df;
    }

    .border-left-success {
        border-left: 4px solid #1cc88a;
    }

    .border-left-danger {
        border-left: 4px solid #e74a3b;
    }

    .border-left-warning {
        border-left: 4px solid #f6c23e;
    }

    .card {
        border-radius: 10px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>