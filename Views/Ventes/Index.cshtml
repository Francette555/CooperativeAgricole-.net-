@model IEnumerable<tedd.Models.Vente>
@{
    ViewData["Title"] = "Gestion des ventes";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-shopping-cart text-success me-2"></i>@ViewData["Title"]
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Nouvelle vente
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-success">
                <i class="fas fa-list me-2"></i>Liste des ventes
            </h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-4x text-muted mb-3"></i>
                    <h5>Aucune vente enregistrée</h5>
                    <p class="text-muted">Cliquez sur "Nouvelle vente" pour commencer.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                        <thead class="table-success">
                            <tr>
                                <th>Produit</th>
                                <th class="text-end">Quantité</th>
                                <th class="text-end">Prix unitaire</th>
                                <th class="text-end">Montant total</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <i class="fas fa-box text-primary me-1"></i>
                                        @item.TypeProduit?.Nom
                                    </td>
                                    <td class="text-end">@item.Quantite.ToString("N2") @item.TypeProduit?.Unite</td>
                                    <td class="text-end">@item.PrixUnitaire.ToString("N0") Ar</td>
                                    <td class="text-end fw-bold text-success">@item.MontantTotal.ToString("N0") Ar</td>
                                    <td>
                                        <i class="fas fa-user text-muted me-1"></i>
                                        @item.Client
                                    </td>
                                    <td>@item.DateVente.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger delete-confirm" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-success fw-bold">
                            <tr>
                                <td colspan="3" class="text-end">TOTAL DES VENTES :</td>
                                <td class="text-end">@Model.Sum(v => v.MontantTotal).ToString("N0") Ar</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json'
                },
                responsive: true,
                order: [[5, 'desc']]
            });
        });
    </script>
}