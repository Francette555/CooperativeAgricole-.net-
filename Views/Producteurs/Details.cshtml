@model tedd.Models.Producteur
@{
    ViewData["Title"] = "Détails du Producteur";
}

<div class="container-fluid">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations personnelles</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Nom complet</dt>
                        <dd class="col-sm-8">@Model.NomComplet</dd>

                        <dt class="col-sm-4 fw-bold">Téléphone</dt>
                        <dd class="col-sm-8">@Model.Telephone</dd>

                        <dt class="col-sm-4 fw-bold">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 fw-bold">Adresse</dt>
                        <dd class="col-sm-8">@Model.Adresse</dd>

                        <dt class="col-sm-4 fw-bold">Date d'inscription</dt>
                        <dd class="col-sm-8">@Model.DateInscription.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 fw-bold">Statut</dt>
                        <dd class="col-sm-8">
                            @if (Model.EstActif)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactif</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">Retour</a>
                </div>
            </div>
        </div>

        <!-- Statistiques du producteur -->
        <div class="col-md-6">
            <div class="card shadow mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Statistiques</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center">
                                <h3>@(Model.Recoltes?.Count ?? 0)</h3>
                                <small class="text-muted">Nombre de récoltes</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h3>@(Model.Paiements?.Count ?? 0)</h3>
                                <small class="text-muted">Nombre de paiements</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste des récoltes -->
            @if (Model.Recoltes != null && Model.Recoltes.Any())
            {
                <div class="card shadow">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Dernières récoltes</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var recolte in Model.Recoltes.OrderByDescending(r => r.DateRecolte).Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@recolte.TypeProduit?.Nom : @recolte.Quantite.ToString("N2") kg</span>
                                    <span class="badge bg-secondary">@recolte.DateRecolte.ToString("dd/MM/yyyy")</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>