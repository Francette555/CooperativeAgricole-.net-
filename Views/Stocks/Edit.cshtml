@model tedd.Models.Stock
@{
    ViewData["Title"] = "Modifier le stock";
}

<div class="container-fluid">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="TypeProduitId" />
                        
                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Produit</label>
                            <input class="form-control" value="@Model.TypeProduit?.Nom" disabled />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Quantite" class="control-label fw-bold">Quantité (kg)</label>
                            <input asp-for="Quantite" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Quantite" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SeuilAlerte" class="control-label fw-bold">Seuil d'alerte (kg)</label>
                            <input asp-for="SeuilAlerte" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="SeuilAlerte" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}